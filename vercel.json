{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/partners",
      "destination": "/join",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/startup",
      "destination": "/api/gone"
    },
    {
      "source": "/closure",
      "destination": "/api/gone"
    },
    {
      "source": "/operation",
      "destination": "/api/gone"
    },
    {
      "source": "/transfer",
      "destination": "/api/gone"
    },
    {
      "source": "/providers",
      "destination": "/api/gone"
    },
    {
      "source": "/franchise",
      "destination": "/api/gone"
    },
    {
      "source": "/stores",
      "destination": "/api/gone"
    },
    {
      "source": "/assets",
      "destination": "/api/gone"
    },
    {
      "source": "/support",
      "destination": "/api/gone"
    },
    {
      "source": "/content",
      "destination": "/api/gone"
    },
    {
      "source": "/sell-biz",
      "destination": "/api/gone"
    },
    {
      "source": "/tools",
      "destination": "/api/gone"
    },
    {
      "source": "/about",
      "destination": "/api/gone"
    },
    {
      "source": "/compare",
      "destination": "/api/gone"
    },
    {
      "source": "/sample",
      "destination": "/api/gone"
    },
    {
      "source": "/closing",
      "destination": "/api/gone"
    },
    {
      "source": "/acquisition",
      "destination": "/api/gone"
    },
    {
      "source": "/companies",
      "destination": "/api/gone"
    },
    {
      "source": "/guides",
      "destination": "/api/gone"
    },
    {
      "source": "/startup/:p*",
      "destination": "/api/gone"
    },
    {
      "source": "/closure/:p*",
      "destination": "/api/gone"
    },
    {
      "source": "/providers/:p*",
      "destination": "/api/gone"
    },
    {
      "source": "/franchise/:p*",
      "destination": "/api/gone"
    },
    {
      "source": "/content/:p*",
      "destination": "/api/gone"
    },
    {
      "source": "/tools/:p*",
      "destination": "/api/gone"
    },
    {
      "source": "/companies/:p*",
      "destination": "/api/gone"
    },
    {
      "source": "/guides/:p*",
      "destination": "/api/gone"
    },
    {
      "source": "/g/:p*",
      "destination": "/api/gone"
    },
    {
      "source": "/c/:p*",
      "destination": "/api/gone"
    },
    {
      "source": "/p/:p*",
      "destination": "/api/gone"
    },
    {
      "source": "/f/:p*",
      "destination": "/api/gone"
    },
    {
      "source": "/s/:p*",
      "destination": "/api/gone"
    },
    {
      "source": "/a/:p*",
      "destination": "/api/gone"
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/img/(.*)\\.(jpg|jpeg|png|webp|avif)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/((?!.*\\.(?:css|js|jpg|jpeg|png|webp|avif|svg|ico|webmanifest)).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=(), camera=(), payment=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; img-src 'self' data:; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; font-src 'self' https://cdn.jsdelivr.net; connect-src 'self'"
        }
      ]
    }
  ]
}
